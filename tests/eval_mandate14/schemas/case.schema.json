{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techx.example/schemas/mandate14-case-v2.json",
  "title": "Mandate 14 scored observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "surface",
    "category",
    "expected",
    "observed"
  ],
  "properties": {
    "schema_version": {
      "const": "mandate14-case-v2"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "surface": {
      "enum": ["review_summary", "copilot"]
    },
    "variant": {
      "enum": ["baseline", "candidate", "hidden"],
      "default": "candidate"
    },
    "category": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "human_pass": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "default": []
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "observed": {
      "$ref": "#/$defs/observed"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "text"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_type": {
          "enum": ["review", "product_description", "catalog", "tool_state"]
        },
        "text": {
          "type": "string"
        },
        "synthetic_pii": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "fact": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "source_type": {
              "enum": ["review", "product_description", "catalog"]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": ["answer", "abstain", "block", "confirm", "write"]
        },
        "answerable": {
          "type": "boolean"
        },
        "valid_task": {
          "type": "boolean"
        },
        "injection_present": {
          "type": "boolean"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "forbidden_pii": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_prompt_fragments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "system_prompt_canary": {
          "type": "string"
        },
        "write_requested": {
          "type": "boolean"
        },
        "write_authorized": {
          "type": "boolean"
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_type", "source_ids"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": ["opinion", "fact", "spec"]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "side_effect"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "side_effect": {
          "type": "boolean"
        },
        "arguments": {}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "response_text",
        "latency_ms",
        "input_tokens",
        "output_tokens",
        "model_requests",
        "estimated_cost_usd"
      ],
      "properties": {
        "outcome": {
          "type": "string"
        },
        "response_text": {
          "type": "string"
        },
        "output_fields": {
          "type": "object"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "blocked": {
          "type": "boolean"
        },
        "refused": {
          "type": "boolean"
        },
        "abstained": {
          "type": "boolean"
        },
        "action_proposed": {
          "type": "boolean"
        },
        "confirmation_required": {
          "type": "boolean"
        },
        "confirmation_received": {
          "type": "boolean"
        },
        "confirmation_token_valid": {
          "type": "boolean"
        },
        "confirmation_binding_match": {
          "type": "boolean"
        },
        "write_attempted": {
          "type": "boolean"
        },
        "write_applied": {
          "type": "boolean"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_call"
          },
          "default": []
        },
        "state_before": {},
        "state_after": {},
        "state_before_sha256": {
          "type": "string"
        },
        "state_after_sha256": {
          "type": "string"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
