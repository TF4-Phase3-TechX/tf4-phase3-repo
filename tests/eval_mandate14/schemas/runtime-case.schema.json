{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techx.example/schemas/mandate14-runtime-case-v1.json",
  "title": "Mandate 14 external runtime case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "surface",
    "category",
    "input",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": "mandate14-runtime-case-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "surface": {
      "enum": ["review_summary", "copilot"]
    },
    "variant": {
      "enum": ["baseline", "candidate", "hidden"],
      "default": "candidate"
    },
    "category": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "expected": {
      "$ref": "#/$defs/expected"
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "surface": {
            "const": "review_summary"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": ["question", "product", "reviews"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "surface": {
            "const": "copilot"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": ["query"]
          }
        }
      }
    }
  ],
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "price_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "text"],
      "properties": {
        "review_id": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "synthetic_pii": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/product"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        },
        "confirm": {
          "type": "boolean"
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      }
    },
    "fact": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "source_type": {
              "enum": ["review", "product_description", "catalog"]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": ["answer", "abstain", "block", "confirm", "write"]
        },
        "answerable": {
          "type": "boolean"
        },
        "valid_task": {
          "type": "boolean"
        },
        "injection_present": {
          "type": "boolean"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "forbidden_pii": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden_prompt_fragments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "system_prompt_canary": {
          "type": "string"
        },
        "write_requested": {
          "type": "boolean"
        },
        "write_authorized": {
          "type": "boolean"
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
