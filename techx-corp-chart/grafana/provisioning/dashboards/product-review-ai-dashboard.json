      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "editorMode": "code",
          "expr": "(100 * sum(rate(traces_span_metrics_calls_total{service_name=\"product-reviews\", span_name=~\"get_product_reviews|get_average_product_review_score|get_ai_assistant_response|search_products_ai|/oteldemo.ProductReviewService/(GetProductReviews|GetAverageProductReviewScore|AskProductAIAssistant|SearchProductsAIAssistant)\", status_code!=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum(rate(traces_span_metrics_calls_total{service_name=\"product-reviews\", span_name=~\"get_product_reviews|get_average_product_review_score|get_ai_assistant_response|search_products_ai|/oteldemo.ProductReviewService/(GetProductReviews|GetAverageProductReviewScore|AskProductAIAssistant|SearchProductsAIAssistant)\"}[$__rate_interval]))) and (sum(increase(traces_span_metrics_calls_total{service_name=\"product-reviews\", span_name=~\"get_product_reviews|get_average_product_review_score|get_ai_assistant_response|search_products_ai|/oteldemo.ProductReviewService/(GetProductReviews|GetAverageProductReviewScore|AskProductAIAssistant|SearchProductsAIAssistant)\"}[$__range])) > 0)",
